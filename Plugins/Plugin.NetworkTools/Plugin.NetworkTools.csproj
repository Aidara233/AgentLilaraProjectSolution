<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Plugin.NetworkTools</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AgentLilara.PluginSDK\AgentLilara.PluginSDK.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.41.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyToHostPlugins" AfterTargets="Build" Condition=" '$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*' ">
    <ItemGroup>
      <_PluginOut Include="$(OutputPath)*.dll" Exclude="$(OutputPath)AgentLilara.PluginSDK.dll" />
      <_PluginOut Include="$(OutputPath)*.deps.json" />
      <_PluginOut Include="$(OutputPath)plugin.json" />
      <_PluginOut Include="$(OutputPath)playwright.ps1" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginOut)"
          DestinationFolder="$(HostPluginsDir)$(MSBuildProjectName)\"
          SkipUnchangedFiles="true" />
    <!-- .playwright 目录需要保留完整相对路径 -->
    <ItemGroup>
      <_PlaywrightFiles Include="$(OutputPath).playwright\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PlaywrightFiles)"
          DestinationFolder="$(HostPluginsDir)$(MSBuildProjectName)\.playwright\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
