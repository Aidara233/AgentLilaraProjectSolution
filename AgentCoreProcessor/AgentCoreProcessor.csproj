<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(HostTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 裁剪关闭：项目重度依赖反射（插件扫描 / Newtonsoft / Blazor），一裁剪即启动失败 -->
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 单文件发布：托管程序集打包进 exe；原生库（e_sqlite3/libSkiaSharp/onnxruntime）
         仍散落在 exe 旁（默认 IncludeNativeLibrariesForSelfExtract=false），不启用压缩以省内存/启动时间 -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 发布时不复制调试符号文件 -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- 智能体长驻进程非高并发 Web 服务，关闭 Web SDK 默认的 Server GC
         （16 核下预提交 6~7GB 内存，实际业务用不上），改工作站 GC 省内存 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentCoreProcessor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic.SDK" Version="5.10.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SocketIOClient" Version="4.0.5" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentLilara.PluginSDK\AgentLilara.PluginSDK.csproj" />
    <ProjectReference Include="..\AgentLilara.SessionBrain\AgentLilara.SessionBrain.csproj" />
    <ProjectReference Include="..\AgentLilara.AlcBridge\AgentLilara.AlcBridge.csproj" />
    <ProjectReference Include="..\src\AgentLilara.GraphRuntime\AgentLilara.GraphRuntime.csproj" />
    <ProjectReference Include="..\src\Lilara.Logging\Lilara.Logging.csproj" />
    <ProjectReference Include="..\src\Lilara.Data\Lilara.Data.csproj" />
    <ProjectReference Include="..\src\Lilara.Context\Lilara.Context.csproj" />
    <ProjectReference Include="..\src\Lilara.Llm\Lilara.Llm.csproj" />
    <ProjectReference Include="..\src\Lilara.Vision\Lilara.Vision.csproj" />
    <ProjectReference Include="..\src\Lilara.Graph\Lilara.Graph.csproj" />
    <ProjectReference Include="..\src\Lilara.Recurring\Lilara.Recurring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="WebUI\wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="WebUI\wwwroot" />
    <Content Update="Graphs\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- paths.json 不由构建拷贝，首次启动由 SetupWizard 生成 -->
  <ItemGroup>
    <Content Remove="paths.json" />
  </ItemGroup>

  <!-- 发布后清理所有 .pdb 文件 -->
  <Target Name="RemovePdbFiles" AfterTargets="Publish">
    <ItemGroup>
      <PdbFiles Include="$(PublishDir)*.pdb" />
      <PdbFilesRecursive Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbFiles)" />
    <Delete Files="@(PdbFilesRecursive)" />
    <Message Text="已删除发布目录中的所有 .pdb 文件" Importance="high" />
  </Target>

</Project>
