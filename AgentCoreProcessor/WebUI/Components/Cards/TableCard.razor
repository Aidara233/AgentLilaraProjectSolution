@using AgentLilara.PluginSDK.WebUI
@using System.Text.Json.Nodes
@inject NavigationManager Nav
@implements IDisposable

<div class="table-card">
    @if (Schema.Searchable || Schema.Filters?.Count > 0)
    {
        <div class="table-card-toolbar mb-2 d-flex gap-2 flex-wrap align-items-center">
            @if (Schema.Searchable)
            {
                <input class="form-control form-control-sm" style="max-width:200px" placeholder="搜索..." @bind="_search" @bind:event="oninput" @bind:after="OnSearchChanged" />
            }
            @if (Schema.Filters != null)
            {
                foreach (var filter in Schema.Filters)
                {
                    <select class="form-select form-select-sm" style="max-width:140px"
                            @bind="_filters[filter.Field]" @bind:after="ApplyFilter">
                        @if (filter.AllowEmpty)
                        {
                            <option value="">@filter.Label</option>
                        }
                        @foreach (var opt in filter.Options)
                        {
                            <option value="@opt.Value">@opt.Label</option>
                        }
                    </select>
                }
            }
            @if (_searchDebounce)
            {
                <span class="text-muted small">输入中…</span>
            }
        </div>
    }

    <div class="table-responsive">
        <table class="table-dark-custom">
            <thead>
                <tr>
                    @foreach (var col in Schema.Columns)
                    {
                        <th style="@(col.Width != null ? $"width:{col.Width}" : "")"
                            class="@(col.Sortable ? "sortable-col" : "")"
                            @onclick="async () => { if (col.Sortable) await ToggleSort(col.Field); }">
                            @col.Header
                            @if (_sortBy == col.Field)
                            {
                                <i class="bi @(_sortDesc ? "bi-sort-down" : "bi-sort-up") ms-1"></i>
                            }
                        </th>
                    }
                    @if (Schema.RowActions?.Count > 0)
                    {
                        <th>操作</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (DisplayRows != null)
                {
                    var rowIndex = 0;
                    @foreach (var row in DisplayRows)
                    {
                        var link = row["_link"]?.ToString();
                        var idx = rowIndex;
                        var rowKey = GetRowKey(row, idx);
                        var isSelectable = link == null && OnRowSelect.HasDelegate;
                        var isSelected = isSelectable && string.Equals(_selectedKey, rowKey, StringComparison.Ordinal);
                        <tr class="@(link != null ? "row-clickable" : "") @(isSelectable ? "row-selectable" : "") @(isSelected ? "row-selected" : "")"
                            @onclick="() => HandleRowClick(link, rowKey, row)">
                            @foreach (var col in Schema.Columns)
                            {
                                <td>@RenderCell(row, col)</td>
                            }
                            @if (Schema.RowActions?.Count > 0)
                            {
                                <td>
                                    @foreach (var action in Schema.RowActions)
                                    {
                                        <button class="btn btn-sm @(action.Danger ? "btn-outline-danger" : "btn-outline-secondary") me-1"
                                                @onclick="() => HandleRowAction(action, row, rowKey)" @onclick:stopPropagation>
                                            @action.Label
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                        rowIndex++;
                    }
                }
                else
                {
                    <tr><td colspan="@(Schema.Columns.Count + (Schema.RowActions?.Count > 0 ? 1 : 0))" class="text-center text-muted-custom" style="padding:1.5rem">@(IsServerPaged ? "本页暂无数据" : "暂无数据")</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Schema.Paginated)
    {
        <div class="table-card-pagination d-flex align-items-center justify-content-between mt-2 px-1">
            <span class="text-muted small">共 @EffectiveTotalCount 条</span>
            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="PrevPage">上一页</button>
                <span class="btn btn-sm disabled">@_page / @TotalPages</span>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(_page >= TotalPages)" @onclick="NextPage">下一页</button>
            </div>
        </div>
    }
    else if (EffectiveTotalCount > 0)
    {
        <div class="table-card-pagination d-flex align-items-center mt-2 px-1">
            <span class="text-muted small">共 @EffectiveTotalCount 条</span>
        </div>
    }

    @if (_confirmAction != null && _confirmRow != null)
    {
        <div class="confirm-overlay" @onclick="CancelConfirm">
            <div class="confirm-dialog" @onclick:stopPropagation="true">
                <div class="confirm-body">@(ConfirmText(_confirmAction) ?? _confirmAction.Label)</div>
                <div class="confirm-footer">
                    <button class="btn btn-sm btn-ghost" @onclick="CancelConfirm">取消</button>
                    <button class="btn btn-sm @(_confirmAction.Danger ? "btn-danger" : "btn-primary")" @onclick="ExecuteConfirmed">确认</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TableSchema Schema { get; set; } = null!;
    [Parameter] public JsonNode? Data { get; set; }
    [Parameter] public int? TotalCount { get; set; }
    /// <summary>由页面按数据源声明注入；服务端分页时不再次本地 Skip/Take。</summary>
    [Parameter] public DataPagingMode Paging { get; set; } = DataPagingMode.Client;
    [Parameter] public EventCallback<DataQuery> OnQueryChanged { get; set; }
    [Parameter] public EventCallback<(string ActionId, JsonNode Row)> OnRowAction { get; set; }
    [Parameter] public EventCallback<JsonNode> OnRowSelect { get; set; }

    private List<JsonNode>? _rows;
    private string? _search;
    private string? _sortBy;
    private bool _sortDesc;
    private int _page = 1;
    private int _pageSize = 20;
    private string? _selectedKey;
    private Dictionary<string, string> _filters = new();
    private bool _searchDebounce;
    private string? _filterSignature;
    private CancellationTokenSource? _searchCts;

    private RowAction? _confirmAction;
    private JsonNode? _confirmRow;
    private string? _confirmRowKey;

    private bool IsServerPaged => Paging == DataPagingMode.Server;

    private List<JsonNode>? FilteredRows
    {
        get
        {
            if (_rows == null) return null;
            // 服务端分页：数据源已经完成搜索/排序/分页，客户端不再二次处理。
            if (IsServerPaged) return _rows;

            var items = _rows.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var lower = _search.ToLowerInvariant();
                items = items.Where(r =>
                    Schema.Columns.Any(col =>
                        (r[col.Field]?.ToString() ?? "").ToLowerInvariant().Contains(lower)));
            }

            foreach (var (field, value) in _filters)
            {
                if (!string.IsNullOrEmpty(value))
                    items = items.Where(r => (r[field]?.ToString() ?? "") == value);
            }

            if (!string.IsNullOrEmpty(_sortBy))
            {
                items = _sortDesc
                    ? items.OrderByDescending(r => r[_sortBy]?.ToString() ?? "", StringComparer.OrdinalIgnoreCase)
                    : items.OrderBy(r => r[_sortBy]?.ToString() ?? "", StringComparer.OrdinalIgnoreCase);
            }

            return items.ToList();
        }
    }

    private List<JsonNode>? DisplayRows
    {
        get
        {
            var filtered = FilteredRows;
            if (filtered == null) return null;
            if (!Schema.Paginated || IsServerPaged) return filtered;
            return filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
        }
    }

    private int EffectiveTotalCount
    {
        get
        {
            if (IsServerPaged)
                return TotalCount ?? (_rows?.Count ?? 0);
            return FilteredRows?.Count ?? 0;
        }
    }

    private int TotalPages => Schema.Paginated && _pageSize > 0
        ? Math.Max(1, (int)Math.Ceiling(EffectiveTotalCount / (double)_pageSize))
        : 1;

    protected override void OnParametersSet()
    {
        if (_pageSize <= 0 || _pageSize == 20)
            _pageSize = Schema.DefaultPageSize;

        if (Data is JsonArray arr)
            _rows = arr.Where(n => n != null).Select(n => n!).ToList();
        else
            _rows = null;

        // 数据源切换/刷新后重建页码选项。
        var signature = string.Join('|', Schema.Filters?.Select(f => f.Field) ?? Enumerable.Empty<string>());
        if (signature != _filterSignature)
        {
            _filterSignature = signature;
            _filters.Clear();
        }

        if (Schema.Filters != null)
        {
            foreach (var filter in Schema.Filters)
            {
                if (!_filters.ContainsKey(filter.Field))
                    _filters[filter.Field] = "";
            }
        }

        // 数据缩小或服务端返回末页时，避免停在无效页。
        // 这里只修正页码，不主动触发查询，避免渲染过程中再次请求形成循环。
        if (_page > TotalPages)
            _page = TotalPages;
    }

    private string GetRowKey(JsonNode row, int index)
    {
        var keyField = Schema.RowKeyField ?? "_row_id";
        var value = row[keyField]?.ToString();
        if (string.IsNullOrEmpty(value) && keyField != "id")
            value = row["id"]?.ToString();
        if (string.IsNullOrEmpty(value))
            value = row["name"]?.ToString();
        return string.IsNullOrEmpty(value) ? $"#{index}" : value;
    }

    private RenderFragment RenderCell(JsonNode row, ColumnDef col) => __builder =>
    {
        var val = row[col.Field]?.ToString() ?? "";
        if (col.Format == ColumnFormat.Image)
        {
            var src = row["_img_src"]?.ToString() ?? val;
            <img src="@src" class="table-thumbnail" style="width:80px;height:60px;object-fit:cover;border-radius:4px;" loading="lazy" />
        }
        else if (col.Format == ColumnFormat.Link)
        {
            var href = row["_link"]?.ToString();
            if (href != null)
            {
                <a href="@href" class="table-link" @onclick="() => Nav.NavigateTo(href)" @onclick:preventDefault>@val</a>
            }
            else
            {
                @val
            }
        }
        else
        {
            @val
        }
    };

    private async Task ToggleSort(string field)
    {
        if (_sortBy == field) _sortDesc = !_sortDesc;
        else { _sortBy = field; _sortDesc = false; }
        _page = 1;
        if (IsServerPaged)
            await EmitQuery();
    }

    private async Task OnSearchChanged()
    {
        _page = 1;

        if (!IsServerPaged) return;

        // 服务端搜索做短防抖，避免每个按键都打一次数据源。
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        var cts = new CancellationTokenSource();
        _searchCts = cts;
        _searchDebounce = true;
        try
        {
            await Task.Delay(300, cts.Token);
            if (cts.IsCancellationRequested) return;
            _searchDebounce = false;
            await EmitQuery();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task ApplyFilter()
    {
        _page = 1;
        if (IsServerPaged)
            await EmitQuery();
    }

    /// <summary>删除行等破坏性操作默认需要确认；未声明 Confirm 时也给出统一确认。</summary>
    private static string? ConfirmText(RowAction action)
        => !string.IsNullOrEmpty(action.Confirm)
            ? action.Confirm
            : action.Danger ? $"确认执行「{action.Label}」？" : null;

    private async Task PrevPage()
    {
        if (_page > 1) { _page--; await EmitQuery(); }
    }

    private async Task NextPage()
    {
        if (_page < TotalPages) { _page++; await EmitQuery(); }
    }

    private async Task EmitQuery(List<DataFilter>? filters)
    {
        var query = new DataQuery
        {
            Page = _page,
            PageSize = _pageSize,
            Search = _search,
            SortBy = _sortBy,
            SortDesc = _sortDesc,
            Filters = filters
        };

        if (IsServerPaged || Schema.Paginated)
            await OnQueryChanged.InvokeAsync(query);
    }

    private async Task EmitQuery()
    {
        List<DataFilter>? filters = null;
        if (_filters.Count > 0)
        {
            filters = new List<DataFilter>();
            foreach (var (field, value) in _filters)
            {
                if (!string.IsNullOrEmpty(value))
                    filters.Add(new DataFilter { Field = field, Operator = "eq", Value = value });
            }
        }
        await EmitQuery(filters);
    }

    private void HandleRowAction(RowAction action, JsonNode row, string rowKey)
    {
        if (ConfirmText(action) is not null)
        {
            _confirmAction = action;
            _confirmRow = row;
            _confirmRowKey = rowKey;
            return;
        }

        _ = ExecuteRowAction(action, row, rowKey);
    }

    private async Task ExecuteRowAction(RowAction action, JsonNode row, string rowKey)
    {
        var payload = row.DeepClone();
        if (payload is JsonObject obj)
            obj["_row_id"] = rowKey;
        await OnRowAction.InvokeAsync((action.Id, payload));
    }

    private async Task ExecuteConfirmed()
    {
        var action = _confirmAction;
        var row = _confirmRow;
        var rowKey = _confirmRowKey;
        CancelConfirm();
        if (action != null && row != null && rowKey != null)
            await ExecuteRowAction(action, row, rowKey);
    }

    private void CancelConfirm()
    {
        _confirmAction = null;
        _confirmRow = null;
        _confirmRowKey = null;
    }

    private void OnKeyUp(KeyboardEventArgs e)
    {
        // 关键词搜索由 oninput 防抖提交；按键事件保留给未来快捷键扩展。
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    private async Task HandleRowClick(string? link, string rowKey, JsonNode row)
    {
        if (link != null)
        {
            Nav.NavigateTo(link);
            return;
        }
        if (OnRowSelect.HasDelegate)
        {
            _selectedKey = rowKey;
            await OnRowSelect.InvokeAsync(row);
        }
    }
}
