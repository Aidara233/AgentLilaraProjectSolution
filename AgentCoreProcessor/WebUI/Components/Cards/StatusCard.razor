@using AgentLilara.PluginSDK.WebUI
@using System.Text.Json.Nodes

<div class="status-card p-3">
    <div class="status-fields">
        @foreach (var field in Schema.Fields)
        {
            <div class="status-field-row">
                <span class="status-field-label">@field.Label</span>
                @if (field.IsMultiline)
                {
                    <pre class="status-field-multiline">@GetFieldValue(field)</pre>
                }
                else
                {
                    <span class="status-field-value @GetValueClass(field)" style="@GetIndicatorStyle(field)">
                        @GetFieldValue(field)
                    </span>
                }
            </div>
        }
    </div>

    @if (Schema.Actions?.Count > 0)
    {
        <div class="status-actions">
            @foreach (var action in Schema.Actions)
            {
                var disabled = IsActionDisabled(action.Id);
                <button class="btn btn-sm @(action.Danger ? "btn-outline-danger" : "btn-ghost")"
                        disabled="@disabled"
                        @onclick="() => HandleAction(action)">
                    @if (!string.IsNullOrEmpty(action.Icon))
                    {
                        <i class="bi @action.Icon me-1"></i>
                    }
                    @action.Label
                </button>
            }
        </div>
    }

    @if (confirmAction != null)
    {
        <div class="confirm-overlay" @onclick="() => confirmAction = null">
            <div class="confirm-dialog" @onclick:stopPropagation="true">
                <div class="confirm-body">@confirmAction.Confirm</div>
                <div class="confirm-footer">
                    <button class="btn btn-sm btn-ghost" @onclick="() => confirmAction = null">取消</button>
                    <button class="btn btn-sm btn-primary" @onclick="() => ExecuteConfirmed()">确认</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public StatusSchema Schema { get; set; } = null!;
    [Parameter] public JsonNode? Data { get; set; }
    [Parameter] public EventCallback<string> OnAction { get; set; }

    private ActionButton? confirmAction;

    private string GetFieldValue(StatusField field)
    {
        if (Data is not JsonObject obj) return "-";
        var val = obj[field.Field];
        return val?.ToString() ?? "-";
    }

    private string GetValueClass(StatusField field)
    {
        if (field.Type == StatusFieldType.Badge)
            return "badge";
        if (field.Type == StatusFieldType.Indicator)
            return "status-indicator";
        return "";
    }

    private string GetIndicatorStyle(StatusField field)
    {
        if (field.Type != StatusFieldType.Indicator)
            return "";

        var val = GetFieldValue(field).ToLowerInvariant();
        return val switch
        {
            "running" or "active" or "online" or "ok" or "运行中" or "活跃" or "空闲" => "color: var(--status-ok)",
            "stopped" or "offline" or "error" or "停止" or "已停止" or "未启动" or "调用失败" => "color: var(--status-error)",
            "idle" or "sleeping" or "paused" or "睡眠" or "暂停" or "处理中" => "color: var(--status-warn)",
            _ => ""
        };
    }

    private async Task HandleAction(ActionButton action)
    {
        if (!string.IsNullOrEmpty(action.Confirm))
        {
            confirmAction = action;
            return;
        }
        await OnAction.InvokeAsync(action.Id);
    }

    private async Task ExecuteConfirmed()
    {
        var action = confirmAction;
        confirmAction = null;
        if (action != null)
            await OnAction.InvokeAsync(action.Id);
    }

    private bool IsActionDisabled(string actionId)
    {
        if (Data is not JsonObject obj) return false;
        if (obj["_disabled_actions"] is not JsonArray arr) return false;
        return arr.Any(a => a?.ToString() == actionId);
    }
}
